<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/chatWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Toggle button (arrow down) — floating top-right -->
    <ImageButton
        android:id="@+id/btnMenuToggle"
        android:background="@drawable/glass_button_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_down"
        android:contentDescription="Menu" />

    <!-- Dropdown menu — glass style, slides in from top -->
    <LinearLayout
        android:id="@+id/menuBar"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/glass_background"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnReload"
            android:background="@drawable/glass_button_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_reload"
            android:contentDescription="Reload" />

        <ImageButton
            android:id="@+id/btnRestrict"
            android:background="@drawable/glass_button_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Toggle restricted mode" />

        <ImageButton
            android:id="@+id/btnClearData"
            android:background="@drawable/glass_button_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Clear all data" />

        <ImageButton
            android:id="@+id/btnAbout"
            android:background="@drawable/glass_button_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_info"
            android:contentDescription="About" />

    </LinearLayout>

</FrameLayout>
